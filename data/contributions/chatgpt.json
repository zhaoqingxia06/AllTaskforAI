        {"id": "m7", "time": "2026-10-13T19:00:00+08:00", "text": "增加通知发生时间分布，并包含姓名识别。"},
        {"id": "m8", "time": "2026-10-13T16:00:00+08:00", "text": "增加采集3次成功、3次失败、5次成功的人数与次数趋势。"},
        {"id": "m9", "time": "2026-10-13T16:10:00+08:00", "text": "增加点击稍后完成的人数与次数。"}
      ]
    },
