    {
      "id": "chatnote-fixes-20261015",
      "category": "做产品",
      "group": "ChatNote",
      "created_at": "2026-10-15T09:00:00+08:00",
      "updated_at": "2026-10-16T09:00:00+08:00",
      "status": "inProgress",
      "scheduled": false,
      "archived": false,
      "messages": [
        {"id": "m1", "time": "2026-10-15T09:00:00+08:00", "text": "修复 ChatNote 侧边文档交互与保存体验"},
        {"id": "m2", "time": "2026-10-15T09:05:00+08:00", "text": "修复 Ctrl+P 插入标题后无法回车到下一行编辑的问题。"},
        {"id": "m3", "time": "2026-10-15T09:10:00+08:00", "text": "插入待办后回车可延续待办；引用和高亮块需要支持退出到正文，不能一直延续样式。"},
        {"id": "m4", "time": "2026-10-15T09:15:00+08:00", "text": "提供最新扩展安装包，并保留最后一个版本，删除旧版本避免占用空间。"},
        {"id": "m5", "time": "2026-10-15T09:20:00+08:00", "text": "进入已有聊天时也要显示侧边文档状态；ChatGPT 左侧 Chat 列表前增加笔记 icon 标识是否有记录。"},
        {"id": "m6", "time": "2026-10-15T09:25:00+08:00", "text": "扩展名称统一改成 ChatNote。"},
        {"id": "m7", "time": "2026-10-16T01:55:00+08:00", "text": "保存位置一旦选择后默认记住，不要每个 Chat 都重新选择文件夹。"},
        {"id": "m8", "time": "2026-10-16T02:00:00+08:00", "text": "Agent 输出中的表格、代码、引用、列表等块状结构，悬浮时支持整块加入，也支持选中局部内容加入。"}
      ]
    },
    {
